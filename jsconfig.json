{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@css/*": [
                "assets/css/*"
            ],
            "@blocks/*": [
                "src/blocks/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@assetsStyles/*": [
                "src/assets/css/*"
            ],
            "@assetsJS/*": [
                "src/assets/js/*"
            ],
        }
    },
    "exclude": [
        "node_modules",
        "build"
    ]
}